# Wzór pliku /etc/prognozy/prognozy.env (prawa 600, właściciel root).
# Prawdziwych kluczy NIGDY nie wpisuj do repozytorium.

# --- WYMAGANE ---------------------------------------------------------------
# Token konta BOTA na Metaculus (nie konta osobistego).
METACULUS_TOKEN=REPLACE_ME
# Klucz OpenRouter (kredyty od Metaculus po formularzu uczestnika).
OPENROUTER_API_KEY=REPLACE_ME

# --- WYSZUKIWANIE (zalecane: AskNews + model wyszukujący = 2 źródła) --------
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# Własna lista modeli wyszukujących (przecinki). Domyślnie: openrouter/perplexity/sonar-pro
# PROGNOZY_SEARCH_MODELS=openrouter/perplexity/sonar-pro

# --- ZACHOWANIE BOTA --------------------------------------------------------
# Wysyłanie prognoz. Zostaw "false", dopóki "prognozy run --mode test" nie zadziała.
PROGNOZY_PUBLISH=false
# Ile prognoz uśredniać (mediana) na pytanie.
PROGNOZY_PREDICTIONS=5
# Nadpisanie modeli (puste = domyślne z forecasting-tools dla podanych kluczy).
# PROGNOZY_MODEL_DEFAULT=openrouter/openai/gpt-5.4
# PROGNOZY_MODEL_PARSER=openrouter/anthropic/claude-haiku-5.5
# Nowy sezon, zanim biblioteka się zaktualizuje: ID lub slug turnieju.
# PROGNOZY_TOURNAMENT=spring-futureeval-2027

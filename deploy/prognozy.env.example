# Wzór pliku /etc/prognozy/prognozy.env (prawa 600, właściciel root).
# Prawdziwych kluczy NIGDY nie wpisuj do repozytorium.

# --- WYMAGANE ---------------------------------------------------------------
# Token konta BOTA na Metaculus (nie konta osobistego).
METACULUS_TOKEN=REPLACE_ME
# Klucz OpenRouter (kredyty od Metaculus po formularzu uczestnika).
OPENROUTER_API_KEY=REPLACE_ME

# --- WYSZUKIWANIE (zalecane: AskNews + model wyszukujący = 2 źródła) --------
# Klucz z my.asknews.app -> Settings -> API credentials (darmowy dla uczestników po aktywacji).
# ASKNEWS_API_KEY=REPLACE_ME
# Własna lista modeli wyszukujących (przecinki). Domyślnie: openrouter/perplexity/sonar-pro
# PROGNOZY_SEARCH_MODELS=openrouter/perplexity/sonar-pro

# Notowania Polymarket/Manifold jako dodatkowe źródło (bez kluczy). Wyłączenie: false
PROGNOZY_MARKETS=true

# --- POWIADOMIENIA I KOSZTY -------------------------------------------------
# Adres pingu z healthchecks.io (darmowe konto). Mail przy awarii lub ciszy.
# PROGNOZY_HEALTHCHECK_URL=https://hc-ping.com/<twoj-uuid>
# Dzienny limit wydatków na OpenRouter w $. Po przekroczeniu bot czeka do jutra.
PROGNOZY_DAILY_BUDGET_USD=5

# --- ZACHOWANIE BOTA --------------------------------------------------------
# Wysyłanie prognoz. Zostaw "false", dopóki "prognozy run --mode test" nie zadziała.
PROGNOZY_PUBLISH=false
# Ile prognoz uśredniać (mediana) na pytanie.
PROGNOZY_PREDICTIONS=5
# Najwyżej tyle zapytań na minutę do jednego modelu. Nowe konta OpenRouter mają limit 20;
# gdy konto "dojrzeje" (zwykle po kilku dniach i doładowaniu), można podnieść np. do 60.
# PROGNOZY_LLM_RPM=15
# Ile pytań naraz (1 = najbezpieczniej). Więcej = szybciej, ale łatwiej o limit.
# PROGNOZY_PARALLEL_QUESTIONS=1
# Prompt caching dla modeli Claude: kolejne prognozy tego samego pytania płacą ~10% ceny za
# powtarzający się prompt. Wyłączenie: false
# PROGNOZY_PROMPT_CACHE=true
# Nadpisanie modeli (puste = domyślne z forecasting-tools dla podanych kluczy).
# PROGNOZY_MODEL_DEFAULT=openrouter/openai/gpt-5.4
# Zespół modeli: 5 prognoz rozkłada się po kolei na podane modele (mediana z całości).
# Wybór najlepiej oprzeć na "prognozy porownaj" (WDROZENIE.md).
# PROGNOZY_FORECAST_MODELS=openrouter/openai/gpt-5.4,openrouter/anthropic/claude-opus-5.5
# PROGNOZY_MODEL_PARSER=openrouter/anthropic/claude-haiku-5.5
# Nowy sezon, zanim biblioteka się zaktualizuje: ID lub slug turnieju.
# PROGNOZY_TOURNAMENT=spring-futureeval-2027
